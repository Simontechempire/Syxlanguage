{
  "name": "SYX",
  "scopeName": "source.syx",
  "fileTypes": [
    "syx"
  ],
  "patterns": [
    {
      "name": "comment.line.number-sign.syx",
      "match": "#.*$"
    },
    {
      "name": "keyword.control.syx",
      "match": "\\b(if|else|while|for|return)\\b"
    },
    {
      "name": "support.function.syx",
      "match": "\\bsay\\b"
    },
    {
      "name": "constant.language.syx",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "constant.numeric.syx",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "string.quoted.double.syx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.syx",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.operator.assignment.syx",
      "match": "="
    },
    {
      "name": "keyword.operator.comparison.syx",
      "match": "==|!=|>=|<=|>|<"
    }
  ]
}
